{
  "uid": "muse-overview",
  "title": "Muse — Overview (RED + Business)",
  "tags": ["muse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row", "title": "gRPC (Core)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries", "title": "gRPC request rate by method", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [ { "expr": "sum(rate(grpc_server_requests_total[5m])) by (method)", "legendFormat": "{{method}}" } ]
    },
    {
      "type": "timeseries", "title": "gRPC error ratio (non-OK)", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "targets": [ { "expr": "sum(rate(grpc_server_requests_total{code!=\"OK\"}[5m])) / sum(rate(grpc_server_requests_total[5m]))", "legendFormat": "error ratio" } ]
    },
    {
      "type": "timeseries", "title": "gRPC p99 latency by method", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "expr": "histogram_quantile(0.99, sum(rate(grpc_server_request_duration_seconds_bucket[5m])) by (le, method))", "legendFormat": "{{method}}" } ]
    },
    {
      "type": "row", "title": "HTTP (BFFs)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries", "title": "HTTP request rate by service", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "targets": [ { "expr": "sum(rate(http_requests_total[5m])) by (service)", "legendFormat": "{{service}}" } ]
    },
    {
      "type": "timeseries", "title": "HTTP status mix", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "targets": [ { "expr": "sum(rate(http_requests_total[5m])) by (code)", "legendFormat": "{{code}}" } ]
    },
    {
      "type": "timeseries", "title": "HTTP p99 latency by service", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))", "legendFormat": "{{service}}" } ]
    },
    {
      "type": "row", "title": "Business", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "timeseries", "title": "Gameplay funnel (events/s by type)", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [ { "expr": "sum(rate(game_events_total[5m])) by (type)", "legendFormat": "{{type}}" } ]
    },
    {
      "type": "timeseries", "title": "Fulfillment outcomes/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "targets": [ { "expr": "sum(rate(fulfillment_tasks_total[5m])) by (outcome)", "legendFormat": "{{outcome}}" } ]
    },
    {
      "type": "stat", "title": "Cache hit ratio", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } },
      "targets": [ { "expr": "sum(rate(bff_cache_ops_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(bff_cache_ops_total[5m])), 1)", "legendFormat": "hit ratio" } ]
    }
  ]
}
